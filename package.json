{
  "name": "parking-system",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống Quản lý Bãi đỗ xe - Sprint 1",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint --no-error-on-unmatched-pattern src/ tests/",
    "test": "jest",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "contract:lint": "redocly lint docs/contracts/openapi.yaml",
    "contract:test": "jest tests/contracts --runInBand",
    "ci": "npm run lint && npm run contract:lint && npm test -- --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@redocly/cli": "^2.69.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.3",
    "yaml": "^2.9.1"
  }
}
