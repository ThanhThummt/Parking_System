<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <main class="container-fluid py-4 px-3 px-lg-4">
      <div class="p-4 p-lg-5 bg-primary text-white rounded-3 mb-4">
        <p class="text-uppercase small fw-semibold mb-2">Khu vực khách hàng</p>
        <h1 class="h3">Xin chào, <%= currentUser?.fullName || currentUser?.username %></h1>
        <p class="mb-0 opacity-75">Quản lý xe, xem bản đồ và đăng ký vị trí đỗ trong một nơi.</p>
      </div>
      <div class="row g-3 mb-4">
        <div class="col-md-6"><a class="card dashboard-card h-100 text-decoration-none" href="/my-vehicles"><div class="card-body"><h2 class="h5 text-dark">Xe của tôi</h2><p class="text-secondary mb-0">Xem danh sách và trạng thái xe thuộc tài khoản.</p></div></a></div>
        <div class="col-md-6"><a class="card dashboard-card h-100 text-decoration-none" href="/parking/map"><div class="card-body"><h2 class="h5 text-dark">Bản đồ bãi đỗ</h2><p class="text-secondary mb-0">Xem ô trống và đăng ký chỗ cho xe của bạn.</p></div></a></div>
      </div>
      <section class="card dashboard-card">
        <div class="card-header bg-white"><h2 class="h5 mb-0">Tin tức mới</h2></div>
        <div class="list-group list-group-flush">
          <% if (!news.length) { %><div class="p-4 text-secondary">Chưa có tin tức được công bố.</div><% } %>
          <% news.forEach((item) => { %><article class="list-group-item py-3"><h3 class="h6 mb-1"><%= item.title %></h3><p class="small text-secondary mb-0"><%= item.summary || item.content %></p></article><% }) %>
        </div>
      </section>
    </main>
    <%- include('../partials/footer') %>
