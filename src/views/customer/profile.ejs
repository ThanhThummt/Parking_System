<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="container-fluid py-4 px-3 px-lg-4"><div class="mb-4"><p class="text-uppercase small text-primary fw-semibold mb-1">Tài khoản</p><h1 class="h3 mb-1">Hồ sơ khách hàng</h1><p class="text-secondary mb-0">Cập nhật thông tin liên hệ của chính bạn.</p></div><% if (req.query.updated === '1') { %><div class="alert alert-success" role="status">Đã cập nhật hồ sơ.</div><% } %><% if (formError) { %><div class="alert alert-danger" role="alert"><%= formError %></div><% } %><section class="card dashboard-card"><div class="card-body p-4"><form method="post" action="/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="fullName">Họ và tên</label><input class="form-control" id="fullName" name="fullName" value="<%= values?.fullName || profile.fullName %>" required></div><div class="col-md-6"><label class="form-label" for="phone">Số điện thoại</label><input class="form-control" id="phone" name="phone" value="<%= values?.phone || profile.phone %>" required></div><div class="col-md-6"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" value="<%= values?.email || profile.email %>" required></div><div class="col-md-6"><label class="form-label" for="username">Tên đăng nhập</label><input class="form-control" id="username" value="<%= profile.username %>" disabled></div><div class="col-12"><label class="form-label" for="address">Địa chỉ</label><textarea class="form-control" id="address" name="address" rows="3"><%= values?.address || profile.address || '' %></textarea></div></div><div class="d-flex justify-content-end mt-4"><button class="btn btn-primary" type="submit">Lưu hồ sơ</button></div></form></div></section></main><%- include('../partials/footer') %></div></div>
