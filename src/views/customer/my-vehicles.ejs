<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<div class="app-layout"><%- include('../partials/sidebar') %><div class="app-main"><main class="container-fluid py-4 px-3 px-lg-4"><div class="mb-4"><p class="text-uppercase small text-primary fw-semibold mb-1">Tài sản</p><h1 class="h3 mb-1">Xe của tôi</h1><p class="text-secondary mb-0">Danh sách xe thuộc tài khoản CUSTOMER hiện tại.</p></div><div class="row g-3"><% if (!items.length) { %><div class="col-12"><div class="alert alert-light border">Bạn chưa có xe nào.</div></div><% } %><% items.forEach((vehicle) => { %><div class="col-12 col-lg-6"><article class="card dashboard-card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-3"><div><h2 class="h5 mb-1"><%= vehicle.vehicleName %></h2><div class="font-monospace text-primary"><%= vehicle.licensePlate %></div></div><span class="badge <%= vehicle.derivedStatus === 'PARKED' ? 'text-bg-danger' : vehicle.derivedStatus === 'RESERVED' ? 'text-bg-warning' : 'text-bg-success' %>"><%= vehicle.derivedStatus %></span></div><dl class="row small mt-3 mb-0"><dt class="col-5 text-secondary">Hãng xe</dt><dd class="col-7"><%= vehicle.brand || 'Chưa cập nhật' %></dd><dt class="col-5 text-secondary">Loại xe</dt><dd class="col-7"><%= vehicle.vehicleType %></dd><dt class="col-5 text-secondary">Vị trí</dt><dd class="col-7"><%= vehicle.slotCode || 'Chưa có' %></dd><dt class="col-5 text-secondary">Lần ra gần nhất</dt><dd class="col-7"><%= vehicle.lastExitTime ? new Date(vehicle.lastExitTime).toLocaleString('vi-VN') : 'Chưa có' %></dd></dl></div></article></div><% }) %></div></main><%- include('../partials/footer') %></div></div>
