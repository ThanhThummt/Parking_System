<%- include('../partials/auth-head', { title }) %>
<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
      <section class="card shadow-sm border-0">
        <div class="card-body p-4 p-lg-5">
          <a class="small" href="/login">← Quay lại đăng nhập</a>
          <h1 class="h3 mt-3 mb-2">Quên mật khẩu</h1>
          <p class="text-secondary mb-4">Nhập email tài khoản để nhận liên kết đặt lại mật khẩu.</p>
          <% if (sent) { %><div class="alert alert-success" role="status">Nếu email tồn tại, liên kết đặt lại mật khẩu đã được gửi.</div><% } %>
          <% if (formError) { %><div class="alert alert-danger" role="alert"><%= formError %></div><% } %>
          <form method="post" action="/forgot-password" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label" for="email">Email</label>
              <input class="form-control" id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <button class="btn btn-primary w-100" type="submit">Gửi liên kết</button>
          </form>
        </div>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/auth-foot') %>
