<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Parking System' %></title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>
<body>
  <%- include('partials/sidebar') %>
  <div class="container mt-4">
<header class="navbar navbar-expand-lg bg-white border-bottom sticky-top app-header">
  <div class="container-fluid px-3 px-lg-4">
    <button class="btn btn-outline-secondary d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-label="Mở menu">
      <span aria-hidden="true">☰</span>
    </button>
    <a class="navbar-brand fw-bold text-primary" href="/">Parking System</a>
    <div class="ms-auto d-flex align-items-center gap-3">
      <span class="small text-secondary d-none d-sm-inline"><%= currentUser?.fullName || currentUser?.username %></span>
      <form method="post" action="/logout" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-outline-secondary" type="submit">Đăng xuất</button>
      </form>
    </div>
  </div>
</header>
